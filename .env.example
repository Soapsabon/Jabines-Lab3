# Lab 3 Environment Configuration Template
# Copy this file to .env and fill in actual values
# IMPORTANT: .env is in .gitignore and should NEVER be committed

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Supabase Example:
# DB_URL=jdbc:postgresql://[project].supabase.co:5432/postgres
# DB_USER=postgres
# DB_PASSWORD=[your-supabase-password]

# Local PostgreSQL Example:
DB_URL=jdbc:postgresql://localhost:5432/jabines_db
DB_USER=postgres
DB_PASSWORD=

# ============================================
# LEGACYSUPPLY CONFIGURATION
# ============================================

# Your actual API key from LegacySupply
# DO NOT share this key
# DO NOT commit this to Git
# DO NOT show this in logs
LS_API_KEY=your_legacysupply_api_key_here

# LegacySupply API base URL
LS_BASE_URL=https://legacysupply.onrender.com/api/v1

# Your assigned Client/Student ID
LS_CLIENT_ID=22-4660-812

# ============================================
# SCHEDULER CONFIGURATION (optional)
# ============================================

# Retry pending orders interval (minutes)
app.scheduler.retry-interval-minutes=5

# Check order status interval (minutes)
app.scheduler.status-check-interval-minutes=10

# ============================================
# SECURITY NOTES
# ============================================
#
# - This file should be in .gitignore
# - Never commit API keys to Git
# - Use environment variables for production
# - Rotate API keys regularly
# - Enable database access controls
#
# ============================================
